# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.12.9 AS uv
FROM python:3.14.7-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN groupadd --system renderer \
    && useradd --system --gid renderer --home-dir /app renderer

WORKDIR /app
COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    && uv run --no-sync playwright install --with-deps chromium

RUN chown -R renderer:renderer /app
USER renderer

# The renderer application and private service command are implemented in Phase 16.
CMD ["uv", "run", "--no-sync", "python", "-c", "raise SystemExit('renderer is not implemented before Phase 16')"]
